{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],                    // ← YEH ADD KAREIN
      "@app/*": ["./app/*"],
      "@lib/*": ["./app/lib/*"],
      "@/components/*": ["./components/*"],  // ← Components ke liye
      "@/hooks/*": ["./hooks/*"],           // ← Hooks ke liye
      "@/types/*": ["./types/*"],           // ← Types ke liye
      "@/lib/*": ["./lib/*"]                // ← Root lib ke liye (agar hai to)
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}